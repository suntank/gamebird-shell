[Unit]
Description=GameBird Shell UI
After=local-fs.target gblibd.service systemd-user-sessions.service gamebird-tv-mode-init.service
Wants=gblibd.service
Requires=gamebird-tv-mode-init.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
User=gamebird
Group=gamebird
WorkingDirectory=/home/gamebird/gamebird-shell
ExecStart=/usr/local/lib/gamebird/gbshell-start.sh
Restart=always
RestartSec=1
TTYPath=/dev/tty1
# Preserve the initramfs splash until gbshell presents its first full frame.
TTYReset=no
TTYVHangup=no
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
